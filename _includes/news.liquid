<div class="news">
  {% if site.news != blank %}
    {% assign news_size = site.news | size %}
    <div
      class="news-timeline-wrap"
      {% if include.limit and page.announcements.scrollable and news_size > 3 %}
        style="max-height: {{ page.announcements.limit | default: 5 | times: 5 }}rem; overflow-y: auto;"
      {% endif %}
    >
      <ol class="news-timeline">
      {% assign news = site.news | reverse %}
      {% if include.limit and page.announcements.limit and page.announcements.scrollable != true %}
        {% assign news_limit = page.announcements.limit %}
      {% else %}
        {% assign news_limit = news_size %}
      {% endif %}
      {% for item in news limit: news_limit %}
        <li class="news-timeline__item">
          <time class="news-timeline__date">{{ item.date | date: '%b %d, %Y' }}</time>
          <div class="news-timeline__content">
            {% if item.inline %}
              {{ item.content | remove: '<p>' | remove: '</p>' | emojify }}
            {% else %}
              <a class="news-title" href="{{ item.url | relative_url }}">{{ item.title }}</a>
            {% endif %}
          </div>
        </li>
      {% endfor %}
      </ol>
    </div>
  {% else %}
    <p>No news so far...</p>
  {% endif %}
</div>
