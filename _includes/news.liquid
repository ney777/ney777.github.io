<div class="news">
  {% if site.news != blank %}
    {% assign news_size = site.news | size %}
    <div
      class="about-cv-scroll"
      {% if include.limit and page.announcements.scrollable and news_size > 3 %}
        style="max-height: {{ page.announcements.limit | default: 5 | times: 5 }}rem; overflow-y: auto;"
      {% endif %}
    >
      <ul class="card-text font-weight-light list-group list-group-flush about-cv-list">
      {% assign news = site.news | reverse %}
      {% if include.limit and page.announcements.limit and page.announcements.scrollable != true %}
        {% assign news_limit = page.announcements.limit %}
      {% else %}
        {% assign news_limit = news_size %}
      {% endif %}
      {% for item in news limit: news_limit %}
        <li class="list-group-item about-cv-row">
          <div class="about-cv-date">
            <span class="badge font-weight-bold danger-color-dark text-uppercase align-middle">{{ item.date | date: '%b %Y' }}</span>
          </div>
          <div class="about-cv-content">
            {% if item.inline %}
              {{ item.content | remove: '<p>' | remove: '</p>' | emojify }}
            {% else %}
              <a class="news-title" href="{{ item.url | relative_url }}">{{ item.title }}</a>
            {% endif %}
          </div>
        </li>
      {% endfor %}
      </ul>
    </div>
  {% else %}
    <p>No news so far...</p>
  {% endif %}
</div>
