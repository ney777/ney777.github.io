{% assign cv_sections = site.data.cv.cv.sections %}

<section class="card mt-3 p-3 about-card about-card--cv">
  <h3 class="card-title font-weight-medium about-card__title">
    <i class="fa-solid fa-trophy" aria-hidden="true"></i>
    <span>honors &amp; awards</span>
  </h3>
  <ul class="card-text font-weight-light list-group list-group-flush about-cv-list">
    {% for award in cv_sections.Awards %}
      <li class="list-group-item about-cv-row">
        <div class="about-cv-date">
          <span class="about-badge">{{ award.date }}</span>
        </div>
        <h6 class="about-cv-content title font-weight-bold">{{ award.title }}</h6>
      </li>
    {% endfor %}
  </ul>
</section>

<section class="card mt-3 p-3 about-card about-card--cv">
  <h3 class="card-title font-weight-medium about-card__title">
    <i class="fa-solid fa-handshake-angle" aria-hidden="true"></i>
    <span>academic service</span>
  </h3>
  <ul class="card-text font-weight-light list-group list-group-flush about-cv-list">
    {% for service in page.about_cv.academic_service %}
      <li class="list-group-item about-cv-row">
        <div class="about-cv-date">
          <span class="about-badge">service</span>
        </div>
        <div class="about-cv-content">
          <strong>{{ service.role }}:</strong> {{ service.text }}
        </div>
      </li>
    {% endfor %}
  </ul>
</section>
