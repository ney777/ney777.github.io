{% assign cv_sections = site.data.cv.cv.sections %}

<section class="card mt-3 p-3 about-card about-card--cv">
  <h3 class="card-title font-weight-medium about-card__title">
    <i class="fa-solid fa-trophy" aria-hidden="true"></i>
    <span>honors &amp; awards</span>
  </h3>
  <div class="about-list">
    {% for award in cv_sections.Awards %}
      <div class="about-list__item">
        <span>{{ award.title }}</span>
        <time class="about-chip about-chip--year">{{ award.date }}</time>
      </div>
    {% endfor %}
  </div>
</section>

<section class="card mt-3 p-3 about-card about-card--cv">
  <h3 class="card-title font-weight-medium about-card__title">
    <i class="fa-solid fa-handshake-angle" aria-hidden="true"></i>
    <span>academic service</span>
  </h3>
  <div class="about-service">
    {% for service in page.about_cv.academic_service %}
      <p><strong class="about-chip about-chip--service">{{ service.role }}</strong> {{ service.text }}</p>
    {% endfor %}
  </div>
</section>
